# ── LLM Policy Simulation — API Keys ──
# Copy this file to .env and fill in the keys you have.
#   cp .env.example .env
#
# Providers currently needed by the simulation plan:
#   OpenAI (GPT-4.1, GPT-4.1 mini, GPT-4o)
#   Anthropic (Claude Sonnet 4.6)       ← you said you'll provide later
#   Google (Gemini 2.5 Pro, Flash)
#   DeepSeek (DeepSeek-V3.2)
#   Qwen (DashScope)                     ← you said you'll provide later
#   Meta (Together AI for Llama 3.1 70B)
#
# Only set the keys you have. Missing providers will be skipped with errors logged.

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
DEEPSEEK_API_KEY=sk-...
DASHSCOPE_API_KEY=sk-...
TOGETHER_API_KEY=...

# Xiaomi MiMo
MIMO_API_KEY=your_mimo_key_here
MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1

# LM Studio (local) — OpenAI-compatible server at http://127.0.0.1:1234
# api_key can be any non-empty string; the server does not validate it.
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
